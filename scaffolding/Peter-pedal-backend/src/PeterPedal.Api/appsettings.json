{
  "ConnectionStrings": {
    "PeterPedal": "Data Source=peterpedal.db"
  },
  "FrontendOrigin": "http://localhost:5100",
  "Jwt": {
    "Issuer": "PeterPedal.Api",
    "Audience": "PeterPedal.Frontend",
    "LifetimeMinutes": 2
  },
  "RateLimiting": {
    "LoginPermitsPerMinute": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
